[Unit]
Description=morfUpdate - local verified update agent
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__
StateDirectory=morfsystem/morfupdate
ExecStart=__APP_DIR__/morfupdate --config __CONFIG_DIR__/morfupdate.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# VOLONTAIREMENT NON DURCI (etape D de l'hygiene, 2026-10-10) : morfUpdate delegue les
# operations privilegiees a un helper setuid (dpkg, systemctl, echange /opt). NoNewPrivileges
# annulerait le setuid ; ProtectSystem=strict rendrait /usr et /var/lib/dpkg non inscriptibles
# pour le helper. Ne pas ajouter ces directives sans avoir repense le helper.

[Install]
WantedBy=multi-user.target
