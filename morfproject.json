{
  "schema_version": 1,
  "project": { "id": "morfUpdate", "type": "service" },
  "packaging": {
    "provider": "morfdeploy",
    "targets": {
      "linux-amd64-deb": { "platform": { "os": "linux", "arch": "x86_64" }, "build": { "preset": "linux" }, "package": { "format": "deb", "architecture": "amd64", "ci": { "workflow": "packages.yml", "artifact": "morfupdate-deb-amd64", "file": "morfupdate-{version}-linux-amd64.deb" } } },
      "linux-arm64-deb": { "platform": { "os": "linux", "arch": "arm64" }, "build": { "preset": "linux-arm64" }, "package": { "format": "deb", "architecture": "arm64", "ci": { "workflow": "packages.yml", "artifact": "morfupdate-deb-arm64", "file": "morfupdate-{version}-linux-arm64.deb" } } },
      "windows-x86_64-zip": { "platform": { "os": "windows", "arch": "x86_64" }, "build": { "preset": "mingw" }, "package": { "format": "zip", "ci": { "workflow": "packages.yml", "artifact": "morfupdate-windows", "file": "morfupdate-{version}-windows-x86_64.zip" } } }
    }
  }
}
