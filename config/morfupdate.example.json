{
  "http_port": 8794,
  "bind_address": "127.0.0.1",
  "_comment": "project = identifiant GitHub (celui que PhotoHub/morfMonitor envoient). service = unite systemd. repository = owner/repo. health_url = GET /healthz en boucle locale. morfUpdate n'est PAS une cible : l'agent refuse de se mettre a jour lui-meme. service.py update n'ajoute JAMAIS d'entree dans une liste deja presente : sur une install qui n'avait qu'un service de test, aligner avec : sudo python3 service.py config push --force (depuis le clone), puis systemctl restart morfupdate.",
  "targets": [
    {
      "project": "morfAnalytics",
      "service": "morfanalytics",
      "repository": "morfredus/morfAnalytics",
      "health_url": "http://127.0.0.1:8799/healthz",
      "app_dir": "%ProgramData%/morfanalytics",
      "service_manager": "task"
